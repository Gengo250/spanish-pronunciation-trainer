# ---------------------------------------------------------------------------
# Spanish Pronunciation Trainer — copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- ElevenLabs (text-to-speech for reference audio) ---
ELEVENLABS_API_KEY=your-api-key-here
# Sarah. Free-tier default voices only; "library voices" need a paid plan.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# eleven_multilingual_v2 = best quality (1 credit/char)
# eleven_flash_v2_5      = half the cost (0.5 credit/char), slightly lower quality
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Spanish variant ---
# es-419 = Latin American (default) | es = European (distincion + lleismo)
SPANISH_ACCENT=es-419

# --- Speech-to-text (local, faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# --- Pronunciation assessment (local, ONNX Runtime) ---
PHONEME_MODEL_REPO=duyentq/sonari-wav2vec2-phoneme-int8
PHONEME_MODEL_FILE=wav2vec2_int8.onnx
# Turn off to fall back to transcript+prosody only (no per-sound feedback).
PHONEME_ASSESSMENT_ENABLED=1
# Per-phone GOP below this is treated as a candidate mispronunciation.
# Provisional, from the M0 spike; calibrate on real recordings. See docs/pronunciation-assessment.md
PHONEME_GOP_THRESHOLD=-2.0

# --- Storage ---
DATA_DIR=data
